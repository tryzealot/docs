# Copy this file to `.env` for local development. `.env` is git-ignored.
#
# Paddle client-side token. Sandbox tokens start with `test_`; production
# tokens start with `live_`.
PADDLE_CLIENT_TOKEN=
# `sandbox` or `production`.
PADDLE_ENV=sandbox

# Gateway base URL. ADR-0007 requires the `/api` suffix; the checkout appends
# `/payments/license` and `/payments/orders` to it. There is no default, so set
# it for every build (local, preview and production).
ZEALOT_GATEWAY_URL=

# Must match the gateway's NITRO_ENCRYPTION_KEY / NITRO_ENCRYPTION_SALT,
# otherwise `/orders` cannot decrypt the email query parameter.
ZEALOT_ENCRYPTION_KEY=
ZEALOT_ENCRYPTION_SALT=

# `production` only for the production deploy.
ENVIRONMENT=development
